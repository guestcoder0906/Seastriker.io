# SeaStriker.io runs directly in the browser with global real-time multiplayer.
# Zero environment variables or API keys are required for Vercel deployment!
# Optional dedicated WebSocket proxy URL (e.g. Rivet or custom WebSocket proxy):
# VITE_WS_PROXY_URL=wss://your-ws-proxy.example.com
# Optional port when running full-stack Node server:
PORT=3000
